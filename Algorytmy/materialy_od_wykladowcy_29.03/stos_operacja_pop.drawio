        <mxCell id="s2_wall_l" value="" style="shape=line;strokeColor=#333333;strokeWidth=3;rotation=90;" vertex="1" parent="1">
          <mxGeometry x="605" y="365" width="200" height="10" as="geometry"/>
        </mxCell>
        <mxCell id="s2_wall_r" value="" style="shape=line;strokeColor=#333333;strokeWidth=3;rotation=90;" vertex="1" parent="1">
