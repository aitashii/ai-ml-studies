          <mxGeometry x="240" y="360" width="60" height="25" as="geometry"/>
        </mxCell>

        <mxCell id="s1_state" value="_dane = [10, 20, 30]" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#666666;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="100" y="515" width="170" height="20" as="geometry"/>
        </mxCell>

        <!-- ======= Strzałka pop() ======= -->

        <mxCell id="pop_arrow" value="" style="shape=flexArrow;endArrow=classic;startArrow=none;html=1;fillColor=#CC0000;strokeColor=#990000;width=14;endSize=8;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="410" y="400" as="sourcePoint"/>
