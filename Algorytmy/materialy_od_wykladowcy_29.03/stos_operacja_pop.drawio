          <mxGeometry x="440" y="448" width="90" height="20" as="geometry"/>
        </mxCell>

        <!-- ======= KROK 2: PO pop() ======= -->

        <mxCell id="step2_title" value="&lt;b&gt;KROK 2: PO pop()&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="630" y="170" width="250" height="30" as="geometry"/>
        </mxCell>

        <!-- Stos PO -->
        <mxCell id="s2_bottom" value="" style="shape=line;strokeColor=#333333;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="670" y="500" width="130" height="10" as="geometry"/>
