        <mxCell id="s1_wall_r" value="" style="shape=line;strokeColor=#333333;strokeWidth=3;rotation=90;" vertex="1" parent="1">
          <mxGeometry x="185" y="365" width="200" height="10" as="geometry"/>
        </mxCell>

        <mxCell id="s1_e1" value="&lt;b&gt;10&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="135" y="455" width="100" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="s1_e2" value="&lt;b&gt;20&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="135" y="405" width="100" height="40" as="geometry"/>
