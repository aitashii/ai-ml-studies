        </mxCell>
        <mxCell id="s2_e2" value="&lt;b&gt;20&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="685" y="405" width="100" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="s2_top" value="← TOP (nowy)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#d80073;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="790" y="410" width="110" height="25" as="geometry"/>
        </mxCell>

        <!-- Miejsce po zdjętym elemencie -->
        <mxCell id="s2_ghost" value="&lt;font color=&quot;#CCCCCC&quot;&gt;30&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#CCCCCC;fontSize=14;dashed=1;dashPattern=5 3;" vertex="1" parent="1">
          <mxGeometry x="685" y="355" width="100" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="s2_ghost_label" value="usunięty" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#CCCCCC;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="790" y="360" width="60" height="25" as="geometry"/>
        </mxCell>

        <mxCell id="s2_state" value="_dane = [10, 20]" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#666666;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="650" y="515" width="170" height="20" as="geometry"/>
        </mxCell>

        <!-- Opis kroków -->
        <mxCell id="steps_box" value="&lt;b&gt;Co się dzieje:&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. Sprawdzamy czy stos NIE jest pusty&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;(jeśli pusty → IndexError: underflow)&lt;br&gt;2. pop() usuwa OSTATNI element listy&lt;br&gt;3. Ostatni element = wierzchołek stosu&lt;br&gt;4. Funkcja ZWRACA zdjętą wartość (30)&lt;br&gt;5. Nowym TOP staje się element pod spodem" style="shape=mxgraph.basic.rounded_frame;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=15;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="310" y="570" width="380" height="160" as="geometry"/>
        </mxCell>

        <!-- Underflow warning -->
        <mxCell id="underflow" value="&lt;b&gt;UWAGA: Underflow&lt;/b&gt;&lt;br&gt;pop() na pustym stosie → IndexError!&lt;br&gt;Zawsze sprawdzaj jest_pusty() przed pop()." style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;size=10;" vertex="1" parent="1">
          <mxGeometry x="760" y="580" width="260" height="70" as="geometry"/>
        </mxCell>

        <!-- Złożoność -->
        <mxCell id="complexity" value="&lt;b&gt;Złożoność: O(1)&lt;/b&gt; — jedna operacja, niezależnie od rozmiaru stosu" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=center;" vertex="1" parent="1">
          <mxGeometry x="350" y="750" width="380" height="35" as="geometry"/>
        </mxCell>

