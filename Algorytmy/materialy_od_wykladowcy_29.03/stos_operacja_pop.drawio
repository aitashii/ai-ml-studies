          </mxGeometry>
        </mxCell>
        <mxCell id="pop_text" value="&lt;b&gt;pop()&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontColor=#CC0000;" vertex="1" parent="1">
          <mxGeometry x="450" y="370" width="80" height="25" as="geometry"/>
        </mxCell>

        <!-- Zdjęty element -->
        <mxCell id="removed_elem" value="&lt;b&gt;30&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CC0000;strokeColor=#990000;fontSize=14;fontColor=#FFFFFF;dashed=1;dashPattern=5 3;" vertex="1" parent="1">
          <mxGeometry x="455" y="410" width="60" height="35" as="geometry"/>
        </mxCell>
