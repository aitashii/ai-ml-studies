<mxfile host="app.diagrams.net" modified="2026-03-18T12:00:00.000Z" agent="Claude" version="24.0.0" type="device">
  <diagram id="stos-pop" name="Operacja pop()">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Tytuł -->
        <mxCell id="title" value="&lt;b&gt;Operacja pop() — zdjęcie elementu ze stosu&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="250" y="20" width="600" height="40" as="geometry"/>
        </mxCell>

        <!-- Kod Python -->
        <mxCell id="code" value="&lt;font face=&quot;Courier New&quot;&gt;def pop(self):&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;if self.jest_pusty():&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;raise IndexError(&quot;underflow&quot;)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;return self._dane.pop()&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=15;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="330" y="70" width="400" height="80" as="geometry"/>
        </mxCell>

        <!-- ======= KROK 1: PRZED pop() ======= -->

        <mxCell id="step1_title" value="&lt;b&gt;KROK 1: PRZED pop()&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="80" y="170" width="250" height="30" as="geometry"/>
        </mxCell>

        <!-- Stos PRZED -->
        <mxCell id="s1_bottom" value="" style="shape=line;strokeColor=#333333;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="120" y="500" width="130" height="10" as="geometry"/>
