        <mxCell id="complexity" value="&lt;b&gt;Złożoność: O(1)&lt;/b&gt; — append() na deque to jedna operacja" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=center;" vertex="1" parent="1">
