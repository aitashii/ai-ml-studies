        <mxCell id="s2_state" value="_dane = deque([10, 20, 30, &lt;b&gt;40&lt;/b&gt;])" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#666666;fontFamily=Courier New;" vertex="1" parent="1">
