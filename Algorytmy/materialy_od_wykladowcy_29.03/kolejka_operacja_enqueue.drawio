        <!-- Opis -->
        <mxCell id="steps_box" value="&lt;b&gt;Co się dzieje:&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. Tworzymy nową wartość (40)&lt;br&gt;2. append() dodaje ją na KONIEC (prawy koniec deque)&lt;br&gt;3. Koniec deque = TYŁ kolejki&lt;br&gt;4. Nowy element staje się nowym TYŁem&lt;br&gt;5. PRZÓD się &lt;b&gt;nie zmienia&lt;/b&gt; — kolejność obsługi zachowana" style="shape=mxgraph.basic.rounded_frame;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=15;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="620" y="170" width="380" height="150" as="geometry"/>
        </mxCell>

        <!-- Kluczowa różnica: PRZÓD nie ruszony -->
        <mxCell id="key_diff" value="&lt;b&gt;Kluczowe:&lt;/b&gt; nowy element dołącza na KONIEC.&lt;br&gt;Nie wpływa na to, kto jest obsługiwany następny.&lt;br&gt;(tak jak nowa osoba staje na końcu kolejki w sklepie)" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=15;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="620" y="370" width="400" height="70" as="geometry"/>
        </mxCell>

