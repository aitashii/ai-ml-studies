        <!-- Opis kroków -->
        <mxCell id="steps_box" value="&lt;b&gt;Co się dzieje:&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. Tworzymy nową wartość (40)&lt;br&gt;2. append() dodaje ją na KONIEC listy&lt;br&gt;3. Koniec listy = wierzchołek stosu&lt;br&gt;4. Nowy element staje się nowym TOP&lt;br&gt;&lt;br&gt;Poprzednie elementy &lt;b&gt;nie zmieniają pozycji&lt;/b&gt;!" style="shape=mxgraph.basic.rounded_frame;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=15;spacingRight=10;" vertex="1" parent="1">
