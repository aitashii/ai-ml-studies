                </mxCell>
                <mxCell id="s2_state" value="_dane = deque([20, 30])" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#666666;fontFamily=Courier New;" parent="1" vertex="1">
                    <mxGeometry x="230" y="485" width="200" height="18" as="geometry"/>
                </mxCell>
                <mxCell id="steps_box" value="&lt;b&gt;Co się dzieje:&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. Sprawdzamy czy kolejka NIE jest pusta&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;(jeśli pusta → IndexError: underflow)&lt;br&gt;2. popleft() usuwa PIERWSZY element (przód)&lt;br&gt;3. Funkcja ZWRACA pobraną wartość (10)&lt;br&gt;4. Nowym PRZODEM staje się następny w kolejce (20)&lt;br&gt;5. TYŁ się &lt;b&gt;nie zmienia&lt;/b&gt;" style="shape=mxgraph.basic.rounded_frame;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=15;spacingRight=10;" parent="1" vertex="1">
                    <mxGeometry x="580" y="175" width="400" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="compare_title" value="&lt;b&gt;Dlaczego deque, a nie list?&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="580" y="380" width="250" height="25" as="geometry"/>
                </mxCell>
                <mxCell id="list_box" value="&lt;b&gt;list.pop(0)&lt;/b&gt; — O(n) (wolne!)&lt;br&gt;Usuwa pierwszy element, ale musi&lt;br&gt;PRZESUNĄĆ wszystkie pozostałe o 1 w lewo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=10;" parent="1" vertex="1">
                    <mxGeometry x="580" y="410" width="380" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="deque_box" value="&lt;b&gt;deque.popleft()&lt;/b&gt; — O(1) (szybkie!)&lt;br&gt;Tylko przesuwa wskaźnik na lewy koniec.&lt;br&gt;Żaden element nie jest fizycznie ruszany." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=10;" parent="1" vertex="1">
                    <mxGeometry x="580" y="475" width="380" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="underflow" value="&lt;b&gt;UWAGA: Underflow&lt;/b&gt;&lt;br&gt;dequeue() na pustej kolejce → IndexError!&lt;br&gt;Zawsze sprawdzaj jest_pusta() przed dequeue()." style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;size=10;" parent="1" vertex="1">
                    <mxGeometry x="620" y="560" width="300" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="complexity" value="&lt;b&gt;Złożoność: O(1)&lt;/b&gt; — popleft() na deque to jedna operacja (bez przesuwania)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=center;" parent="1" vertex="1">
                    <mxGeometry x="190" y="570" width="420" height="35" as="geometry"/>
                </mxCell>
