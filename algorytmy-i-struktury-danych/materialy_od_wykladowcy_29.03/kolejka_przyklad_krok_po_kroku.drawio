        <mxCell id="fifo_note" value="&lt;b&gt;Zauważ zasadę FIFO:&lt;/b&gt;&lt;br&gt;Dodaliśmy: Anna, Bartek, Celina&lt;br&gt;Pobraliśmy: &lt;b&gt;Anna&lt;/b&gt;, &lt;b&gt;Bartek&lt;/b&gt; (ta sama kolejność!)&lt;br&gt;&lt;br&gt;Kto pierwszy stanął w kolejce, ten pierwszy&lt;br&gt;został obsłużony — dokładnie jak w sklepie." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=15;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="420" y="420" width="380" height="120" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>